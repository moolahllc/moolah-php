{
    "name": "moolah/poynt",
    "description": "Official PHP client for the Moolah Poynt API",
    "type": "library",
    "license": "MIT",
    "keywords": ["moolah", "poynt", "payments", "dental", "webhooks"],
    "homepage": "https://docs.moolahpay.cc",
    "authors": [{ "name": "Moolah" }],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": { "Moolah\\Poynt\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Moolah\\Poynt\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "php tests/run.php",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
